{
  "name": "saturn",
  "version": "0.1.7-beta",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:backend": "bun --watch src/index.ts",
    "dev:frontend": "bun --cwd web dev",
    "dev": "bun scripts/sync-version.ts && bun entry.ts",
    "build": "bun scripts/sync-version.ts && bun --cwd web build",
    "start": "bun index.ts",
    "version:sync": "bun scripts/sync-version.ts",
    "version:bump": "bun scripts/bump-version.ts",
    "postinstall": "cd web && bun install"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.322",
    "@elysiajs/cors": "^1.2.0",
    "@elysiajs/jwt": "^1.2.0",
    "@elysiajs/static": "^1.2.0",
    "elysia": "^1.2.0",
    "openai": "^4.0.0",
    "tiktoken": "^1.0.22"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/bun": "latest"
  }
}
