# Bootstrap fields. On first start, values migrate to SQLite settings once.
# Existing SQLite values always take precedence; do not change secrets after migration.
# If secrets are absent, Klove generates distinct random values and stores them in SQLite.
PORT=6999
DB_PATH=./data/klove.db
# Optional legacy bootstrap fields. Leave commented to use the web setup on first start.
# If set, these values automatically complete the initial setup and are migrated to SQLite.
# DEFAULT_PASSWORD=replace-with-a-strong-password
# PROFILE_NAME=Your Name
# JWT_SECRET=replace-with-a-long-random-secret
# KLOVE_ENCRYPTION_KEY=replace-with-another-long-random-secret
# Keep existing secret values unchanged when migrating an older installation, or encrypted data may become unreadable.
LOG_LEVEL=info
